# Server-only token used to call the Square Reporting API.
# Personal access token (or OAuth token) with the `REPORTING_READ` scope.
SQUARE_ACCESS_TOKEN=

# Reporting API base URL. Production:
#   https://connect.squareup.com/reporting
# Sandbox:
#   https://connect.squareupsandbox.com/reporting
SQUARE_REPORTING_BASE=https://connect.squareup.com/reporting

# How long to keep the cached `/v1/meta` schema in memory (seconds).
META_CACHE_TTL_SECONDS=3600

# How long to keep the cached merchant location list in memory (seconds).
# Used to drive the friendly location picker in filter rows on `*.location_id`
# dimensions. Requires the token to have the MERCHANT_PROFILE_READ scope.
LOCATIONS_CACHE_TTL_SECONDS=3600

# Long-running queries return `{ "error": "Continue wait" }` and must be retried.
# Maximum number of retry attempts before returning a 504 timeout.
REPORTING_MAX_RETRIES=10

# Delay between retries while a query is still processing (milliseconds).
REPORTING_RETRY_MS=1500

# Optional override for Square's "Connect" host (used for /v2 endpoints like
# /v2/locations). If unset, the host is derived by stripping the `/reporting`
# suffix from SQUARE_REPORTING_BASE.
# SQUARE_CONNECT_BASE=https://connect.squareup.com

# Optional Square-Version header sent with non-Reporting requests. If unset,
# Square uses the version configured for your application.
# SQUARE_API_VERSION=2025-04-16

# Optional ISO 4217 currency override for money formatting in the UI.
# When unset, the app uses the most common currency from /v2/locations
# (e.g. CAD for a Canadian merchant). Example: SQUARE_CURRENCY=CAD
# SQUARE_CURRENCY=

# --- Entegraid main-page SSO (optional) ---
# When configured, only the reporting UI at `/` requires sign-in. `/api/*` and
# other routes are unchanged. Omit these vars (or set ENTEGRAID_MAIN_PAGE_SSO_ENABLED=false)
# for local development without SSO.
#
# ENTEGRAID_MAIN_PAGE_SSO_ENABLED=true
# AUTH_SECRET=                        # openssl rand -base64 32
# AUTH_URL=http://localhost:3000      # public app URL (required in production)
# AUTH_MICROSOFT_ENTRA_ID_ID=
# AUTH_MICROSOFT_ENTRA_ID_SECRET=
# AUTH_MICROSOFT_ENTRA_ID_ALLOWED_TENANTS=<tenant-id>,<other-tenant-id>
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/organizations/v2.0
